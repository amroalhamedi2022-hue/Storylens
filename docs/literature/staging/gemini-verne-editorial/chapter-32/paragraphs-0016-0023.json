  "originalTextAndDraft": [
    {
      "index": 16,
      "en": "“And your cargo?”",
      "existingArabicDraft": "«وما حمولتكم؟»"
    },
    {
      "index": 17,
      "en": "“No freight. Going in ballast.”",
      "existingArabicDraft": "«لا شحنات. نبحر دون حمولة.»"
    },
    {
      "index": 18,
      "en": "“Have you any passengers?”",
      "existingArabicDraft": "«هل على متنكم ركاب؟»"
    },
    {
      "index": 19,
      "en": "“No passengers. Never have passengers. Too much in the way.”",
      "existingArabicDraft": "«لا ركاب. لا أحمل ركابًا أبدًا. إنهم يعيقون العمل.»"
    },
    {
      "index": 20,
      "en": "“Is your vessel a swift one?”",
      "existingArabicDraft": "«هل سفينتكم سريعة؟»"
    },
    {
      "index": 21,
      "en": "“Between eleven and twelve knots. The Henrietta, well known.”",
      "existingArabicDraft": "«بين إحدى عشرة واثنتي عشرة عقدة. هنرييتا معروفة.»"
    },
    {
      "index": 22,
      "en": "“Will you carry me and three other persons to Liverpool?”",
      "existingArabicDraft": "«هل تنقلني أنا وثلاثة أشخاص آخرين إلى ليفربول؟»"
    },
    {
      "index": 23,
      "en": "“To Liverpool? Why not to China?”",
      "existingArabicDraft": "«إلى ليفربول؟ ولمَ لا إلى الصين؟»"
    }
  ],
